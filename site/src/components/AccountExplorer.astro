---
import FeatureStub from './FeatureStub.astro';
import ResearchFields from './ResearchFields.astro';
import type { ResearchField } from './ResearchFields.astro';
import type { DisplayFact } from '../lib/content/facts';

/**
 * Account explorer.
 *
 * FTMO runs the CFD evaluation as two distinct products, and several of their
 * objectives differ — the daily loss allowance, the number of phases, whether
 * the fee can be refunded, and the reward share a trader starts on. Two of the
 * figures that look identical are governed by different mechanisms: the
 * Maximum Loss trails on 1-Step and is static on 2-Step, at the same
 * percentage. (The percentage itself is not written here — like every other
 * figure it lives in the firm record.)
 *
 * The component therefore renders one column per product rather than a single
 * merged specification. Collapsing them would produce a table that is wrong for
 * whichever product the reader is actually looking at, which is the failure
 * mode this whole content architecture exists to prevent.
 *
 * Selecting a specific account size remains a later phase. What is published
 * here is the size range, which is a verified fact; the discrete selector is
 * held by a stub.
 */
export interface ProductGroup {
  title: string;
  /** One line on what the product is. Structure, never a factual claim. */
  summary?: string;
  fields: ResearchField[];
}

interface Props {
  /** Facts that hold for both products. */
  commonFields: ResearchField[];
  groups: ProductGroup[];
  facts?: ReadonlyMap<string, DisplayFact>;
  class?: string;
}

const { commonFields, groups, facts, class: className }: Props = Astro.props;
---

<div class:list={['explorer', className]}>
  <div class="explorer__common">
    <h3 class="explorer__heading">Common to both models</h3>
    <ResearchFields fields={commonFields} facts={facts} minColumn="13rem" />
  </div>

  <div class="explorer__products">
    {
      groups.map((group) => (
        <section class="product">
          <h3 class="product__title">{group.title}</h3>
          {group.summary && <p class="product__summary">{group.summary}</p>}
          <ResearchFields fields={group.fields} facts={facts} minColumn="12rem" />
        </section>
      ))
    }
  </div>

  <FeatureStub
    title="Account size selector"
    description="Choosing a specific account size, and seeing every objective restated in money rather than percentages, is a later phase. The size range above is published; the discrete options between its endpoints are rendered by a selector on FTMO's own site and are not available in its page markup, so they are not reproduced here."
    class="explorer__stub"
  />
</div>

<style>
  .explorer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .explorer__heading,
  .product__title {
    font-size: var(--text-h3);
    margin-bottom: var(--space-4);
  }

  .explorer__products {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(21rem, 100%), 1fr));
  }

  .product {
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }

  .product__title {
    margin-bottom: var(--space-2);
  }

  .product__summary {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-muted);
  }

  @media (max-width: 40rem) {
    .product {
      padding: var(--space-4);
    }
  }
</style>
