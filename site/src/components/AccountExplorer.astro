---
import FeatureStub from './FeatureStub.astro';
import ResearchFields from './ResearchFields.astro';
import type { ResearchField } from './ResearchFields.astro';
import type { DisplayFact } from '../lib/content/facts';

/**
 * Account explorer.
 *
 * FTMO runs the CFD evaluation as two distinct products, and several of their
 * objectives differ — the daily loss allowance, the number of phases, whether
 * the fee can be refunded, and the reward share a trader starts on. Two of the
 * figures that look identical are governed by different mechanisms: the
 * Maximum Loss trails on 1-Step and is static on 2-Step, at the same
 * percentage. (The percentage itself is not written here — like every other
 * figure it lives in the firm record.)
 *
 * The component therefore renders one column per product rather than a single
 * merged specification. Collapsing them would produce a table that is wrong for
 * whichever product the reader is actually looking at, which is the failure
 * mode this whole content architecture exists to prevent.
 *
 * Phase 2C adds a product filter. It is progressive enhancement, not a rewrite:
 * both panels remain in the served HTML exactly as before, and the control is
 * `hidden` until the script reveals it — so a reader without JavaScript sees
 * the full comparison rather than a dead control.
 *
 * There is still no account-size selector, deliberately. Phase 2B could not
 * verify FTMO's discrete account sizes, only the published range, so offering a
 * list of sizes would mean inventing them. The range is shown as the verified
 * fact it is, and the absence is explained rather than papered over.
 */
export interface ProductGroup {
  title: string;
  /** One line on what the product is. Structure, never a factual claim. */
  summary?: string;
  fields: ResearchField[];
}

interface Props {
  /** Facts that hold for both products. */
  commonFields: ResearchField[];
  groups: ProductGroup[];
  facts?: ReadonlyMap<string, DisplayFact>;
  class?: string;
}

const { commonFields, groups, facts, class: className }: Props = Astro.props;
---

<div class:list={['explorer', className]} data-explorer>
  <div class="explorer__common">
    <h3 class="explorer__heading">Common to both models</h3>
    <ResearchFields fields={commonFields} facts={facts} minColumn="13rem" />
  </div>

  {/*
    Revealed by the script. Filtering is a convenience over content that is
    already present, so it must not exist for readers who cannot use it.
  */}
  <fieldset class="explorer__filter" data-explorer-filter hidden>
    <legend class="explorer__filter-legend">Show</legend>
    <div class="explorer__filter-options">
      <label class="choice">
        <input type="radio" name="explorer-product" value="all" checked />
        <span class="choice__label">Both, side by side</span>
      </label>
      {
        groups.map((group) => (
          <label class="choice">
            <input type="radio" name="explorer-product" value={group.title} />
            <span class="choice__label">{group.title}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="explorer__products" data-explorer-products>
    {
      groups.map((group) => (
        <section class="product" data-product={group.title}>
          <h3 class="product__title">{group.title}</h3>
          {group.summary && <p class="product__summary">{group.summary}</p>}
          <ResearchFields fields={group.fields} facts={facts} minColumn="12rem" />
        </section>
      ))
    }
  </div>

  <FeatureStub
    title="Account size selector"
    description="Choosing a specific account size, and seeing every objective restated in money rather than percentages, is a later phase. The size range above is published; the discrete options between its endpoints are rendered by a selector on FTMO's own site and are not available in its page markup, so they are not reproduced here."
    class="explorer__stub"
  />
</div>

<script>
  /**
   * Reveal the filter and apply it. The panels are already in the document —
   * this only sets `hidden` on the ones the reader is not asking for, so no
   * content is ever created, fetched or destroyed by script.
   */
  function init(root: HTMLElement): void {
    const filter = root.querySelector<HTMLFieldSetElement>('[data-explorer-filter]');
    const products = root.querySelectorAll<HTMLElement>('[data-product]');
    if (!filter || products.length === 0) return;

    filter.hidden = false;

    const apply = (): void => {
      const chosen =
        filter.querySelector<HTMLInputElement>('input[name="explorer-product"]:checked')?.value ??
        'all';
      products.forEach((panel) => {
        panel.hidden = chosen !== 'all' && panel.dataset.product !== chosen;
      });
    };

    filter.addEventListener('change', apply);
    apply();
  }

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach(init);
</script>

<style>
  .explorer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .explorer__heading,
  .product__title {
    font-size: var(--text-h3);
    margin-bottom: var(--space-4);
  }

  .explorer__products {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(21rem, 100%), 1fr));
  }

  .product {
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-1);
  }

  .product__title {
    margin-bottom: var(--space-2);
  }

  .product__summary {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-muted);
  }

  /* Product filter (revealed by script) ------------------------------ */
  .explorer__filter {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .explorer__filter-legend {
    padding: 0;
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .explorer__filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .choice {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
  }

  .choice:hover {
    background: var(--color-surface-alt);
  }

  /* State is carried by the native control as well as by the fill. */
  .choice:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .choice input {
    width: 1rem;
    height: 1rem;
    flex: none;
    accent-color: var(--color-accent);
  }

  .choice__label {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  @media (max-width: 40rem) {
    .product {
      padding: var(--space-4);
    }

    .choice {
      width: 100%;
    }
  }
</style>
