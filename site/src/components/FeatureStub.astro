---
/**
 * Placeholder for an interactive feature that has not been built yet.
 *
 * The V2 prototype's information architecture puts three interactive tools on
 * the homepage. Phase 2A migrates the page structure only, so those positions
 * are held by this component rather than by controls that look operable and do
 * nothing — a slider or a quiz that responds to nobody is worse for a keyboard
 * or screen-reader user than an honest description of what will be there.
 *
 * It renders static text: no controls, no focusable elements, no script.
 */
interface Props {
  title: string;
  headingLevel?: 'h2' | 'h3' | 'h4';
  /** What the finished feature will do. */
  description: string;
  class?: string;
}

const {
  title,
  headingLevel: Heading = 'h3',
  description,
  class: className,
}: Props = Astro.props;
---

<div class:list={['stub', className]}>
  <p class="stub__flag">Not built yet</p>
  <Heading class="stub__title">{title}</Heading>
  <p class="stub__body">{description}</p>
  <slot />
</div>

<style>
  .stub {
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-alt);
  }

  .stub__flag {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .stub__title {
    font-size: var(--text-h3);
  }

  .stub__body {
    margin-top: var(--space-3);
    max-width: 60ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-muted);
  }

  @media (max-width: 40rem) {
    .stub {
      padding: var(--space-4);
    }
  }
</style>
