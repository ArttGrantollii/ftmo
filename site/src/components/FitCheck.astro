---
import { toToolFacts } from '../lib/tools/facts';
import { buildFitQuestions, FIT_CHECK_FACT_KEYS } from '../lib/tools/fit-check';
import type { DisplayFact } from '../lib/content/facts';

/**
 * Fit check.
 *
 * A preference-matching questionnaire over the verified differences between the
 * two FTMO evaluation products. It reports which product's published rules line
 * up with the preferences a reader expressed — nothing more. It does not advise
 * a purchase, rate the reader, or say anything about passing or profiting.
 *
 * The questions are generated from the firm record at build time: a difference
 * that is not published produces no question, and where the difference is
 * numeric the direction of the lean is computed by comparing the verified
 * values rather than asserted. See `lib/tools/fit-check.ts`.
 *
 * The questions render as ordinary radio groups in the served HTML, so they are
 * readable and keyboard-operable before the script runs; the script adds the
 * scoring. Without JavaScript the reader still sees every question, every
 * option and the verified facts behind them.
 */
interface Props {
  facts: ReadonlyMap<string, DisplayFact>;
  class?: string;
}

const { facts, class: className } = Astro.props;

const payload = toToolFacts(facts, FIT_CHECK_FACT_KEYS);
const questions = buildFitQuestions(payload);
---

{
  questions.length > 0 && (
    <div class:list={['fit', className]} data-fit data-config={JSON.stringify({ questions, facts: payload })}>
      <form class="fit__form" data-fit-form novalidate>
        <ol class="fit__questions">
          {questions.map((question, index) => (
            <li class="question">
              <fieldset class="question__set">
                <legend class="question__legend">
                  <span class="question__number" aria-hidden="true">
                    {index + 1}
                  </span>
                  {question.legend}
                </legend>
                <p class="question__help">{question.help}</p>
                <div class="question__options">
                  {question.options.map((option) => (
                    <label class="choice">
                      <input type="radio" name={question.id} value={option.id} />
                      <span class="choice__label">{option.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </li>
          ))}
        </ol>

        <div class="fit__actions">
          <button class="fit__reset" type="reset" data-fit-reset hidden>
            Clear answers
          </button>
          <p class="fit__progress" data-fit-progress aria-live="polite" />
        </div>

        {/* The outcome is announced when it changes. */}
        <div class="fit__result" data-fit-result aria-live="polite" />

        <p class="fit__disclaimer">
          This compares your stated preferences against FTMO's published rules. It is informational
          only, based solely on the answers you selected, and is not advice, a recommendation or a
          prediction of any outcome. Confirm the current terms with FTMO before spending anything.
        </p>
      </form>
    </div>
  )
}

<script>
  import {
    describeFitOutcome,
    labelWithProduct,
    orderEvidenceKeys,
    scoreFitCheck,
    type FitQuestion,
  } from '../lib/tools/fit-check';
  import type { ToolFactMap } from '../lib/tools/facts';

  interface FitConfig {
    questions: FitQuestion[];
    facts: ToolFactMap;
  }

  function init(root: HTMLElement): void {
    const raw = root.dataset.config;
    if (!raw) return;

    let config: FitConfig;
    try {
      config = JSON.parse(raw) as FitConfig;
    } catch {
      return; // The questions stay readable; only the scoring is lost.
    }

    const form = root.querySelector<HTMLFormElement>('[data-fit-form]');
    const result = root.querySelector<HTMLElement>('[data-fit-result]');
    const progress = root.querySelector<HTMLElement>('[data-fit-progress]');
    const reset = root.querySelector<HTMLButtonElement>('[data-fit-reset]');
    if (!form || !result) return;

    if (reset) reset.hidden = false;

    function collect(): Record<string, string> {
      const answers: Record<string, string> = {};
      for (const question of config.questions) {
        const chosen = form!.querySelector<HTMLInputElement>(
          `input[name="${question.id}"]:checked`,
        );
        if (chosen) answers[question.id] = chosen.value;
      }
      return answers;
    }

    function render(): void {
      const outcome = scoreFitCheck(config.questions, collect());

      if (progress) {
        progress.textContent =
          outcome.answered === outcome.total
            ? ''
            : `${outcome.answered} of ${outcome.total} answered`;
      }

      result!.replaceChildren();
      if (outcome.outcome === 'incomplete') return;

      const panel = document.createElement('div');
      panel.className = 'outcome';

      const heading = document.createElement('h4');
      heading.className = 'outcome__title';
      heading.textContent = describeFitOutcome(outcome);
      panel.append(heading);

      const tally = document.createElement('p');
      tally.className = 'outcome__tally';
      tally.textContent = `Your answers leaned 1-Step on ${outcome.oneStep} of ${outcome.total} questions and 2-Step on ${outcome.twoStep}.`;
      panel.append(tally);

      // Show the sourced facts the lean was built from, rather than asking for
      // trust in a number the reader cannot see.
      const usable = orderEvidenceKeys(outcome.evidenceKeys)
        .map((key) => config.facts[key])
        .filter((fact): fact is NonNullable<typeof fact> => Boolean(fact));

      if (usable.length > 0) {
        const evidenceTitle = document.createElement('p');
        evidenceTitle.className = 'outcome__term';
        evidenceTitle.textContent = 'The verified differences behind this';
        panel.append(evidenceTitle);

        const list = document.createElement('ul');
        list.className = 'outcome__evidence';
        for (const fact of usable) {
          const item = document.createElement('li');
          const label = document.createElement('span');
          label.className = 'outcome__label';
          label.textContent = `${labelWithProduct(fact.key, fact.label)}: `;
          const value = document.createElement('strong');
          value.textContent = fact.display;
          item.append(label, value);
          list.append(item);
        }
        panel.append(list);
      }

      result!.append(panel);
    }

    form.addEventListener('change', render);
    form.addEventListener('submit', (event) => event.preventDefault());
    // `reset` fires before the controls clear, so re-render on the next tick.
    form.addEventListener('reset', () => window.setTimeout(render, 0));
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-fit]').forEach(init);
</script>

<style>
  .fit {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .fit__questions {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    counter-reset: question;
  }

  .question__set {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .question__legend {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .question__number {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  .question__help {
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-muted);
  }

  .question__options {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
  }

  .choice {
    display: flex;
    align-items: start;
    gap: var(--space-3);
    min-width: 0;
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
  }

  .choice:hover {
    background: var(--color-surface-alt);
  }

  .choice:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .choice input {
    width: 1rem;
    height: 1rem;
    margin-top: 0.2rem;
    flex: none;
    accent-color: var(--color-accent);
  }

  .choice__label {
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .fit__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .fit__reset {
    height: var(--control-height-sm);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .fit__reset:hover {
    background: var(--color-surface-alt);
  }

  .fit__progress:not(:empty) {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .fit :global(.outcome) {
    margin-top: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .fit :global(.outcome__title) {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  .fit :global(.outcome__tally) {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
  }

  .fit :global(.outcome__term) {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .fit :global(.outcome__evidence) {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .outcome__evidence li {
    min-width: 0;
  }

  .fit :global(.outcome__label) {
    color: var(--color-ink-muted);
  }

  .fit__disclaimer {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    max-width: 78ch;
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-muted);
  }

  @media (max-width: 40rem) {
    .fit {
      padding: var(--space-4);
    }
  }
</style>
