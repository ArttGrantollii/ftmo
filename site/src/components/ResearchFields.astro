---
import Badge from './Badge.astro';
import PendingValue from './PendingValue.astro';
import type { DisplayFact } from '../lib/content/facts';

/**
 * A grid of research fields — the labelled slots the site reports on a firm.
 *
 * The field list is *structure*: which questions this site answers about a
 * firm. The values are *facts*, and they arrive only through the validated
 * Fact architecture (`lib/content/facts.ts`). A field whose fact does not
 * exist, or whose fact the active policy will not publish, renders the
 * "not verified yet" marker instead of a number. There is deliberately no
 * prop by which a caller could pass a bare value in and have it render as
 * though it were verified.
 *
 * Facts are supplied as a map keyed by fact key, built by the page from
 * `auditFirm()`. When one is present the component shows its provenance: the
 * source, the verification date, and a badge whenever the value is not
 * verified.
 */
export interface ResearchField {
  /** Matches the `key` of the Fact that will eventually fill this slot. */
  key: string;
  label: string;
  /** What the field means. Explains the field, never asserts a value. */
  description?: string;
}

interface Props {
  fields: ResearchField[];
  /** Publishable facts by key. Empty until values have been verified. */
  facts?: ReadonlyMap<string, DisplayFact>;
  /** Minimum column width for the auto-fitting grid. */
  minColumn?: string;
  class?: string;
}

const {
  fields,
  facts = new Map<string, DisplayFact>(),
  minColumn = '14rem',
  class: className,
}: Props = Astro.props;

const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<ul class:list={['fields', className]} style={`--grid-min: ${minColumn};`}>
  {
    fields.map((field) => {
      const fact = facts.get(field.key);
      return (
        <li class="field">
          <p class="field__label">{field.label}</p>

          <p class="field__value">
            {fact ? (
              <span class="field__figure tabular">{fact.display}</span>
            ) : (
              <PendingValue label={field.label} />
            )}
          </p>

          {fact?.requiresDemoBadge && (
            <p class="field__flag">
              <Badge variant="warning">Unverified — {fact.status}</Badge>
            </p>
          )}

          {/*
            A fact's own note is the caveat that makes the number honest — that
            a limit trails rather than sits still, or that a restriction applies
            to one account type at one stage. It is rendered in preference to
            the field's generic description so the qualification always travels
            with the value it qualifies, never separated from it.
          */}
          {(fact?.notes ?? field.description) && (
            <p class="field__note">{fact?.notes ?? field.description}</p>
          )}

          {fact?.source && (
            <p class="field__source">
              <a href={fact.source.url} rel="nofollow noopener">
                {fact.source.title}
              </a>
              {fact.lastVerified && <> · checked {dateFormat.format(fact.lastVerified)}</>}
            </p>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .fields {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(var(--grid-min), 100%), 1fr));
  }

  .field {
    min-width: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-alt);
  }

  .field__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .field__value {
    margin-top: var(--space-2);
    min-height: 1.75rem;
  }

  .field__figure {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .field__flag {
    margin-top: var(--space-2);
  }

  .field__note {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-muted);
  }

  .field__source {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-ink-faint);
  }
</style>
