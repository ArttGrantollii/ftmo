---
import Container from './Container.astro';

/**
 * Site footer — structural only.
 *
 * Link groups and legal text are passed in. This component deliberately holds
 * no legal wording, company details, disclosures or claims: those are content
 * decisions that belong to the compliance phase, not to a layout primitive.
 */
export interface FooterLink {
  label: string;
  href: string;
}

export interface FooterGroup {
  heading: string;
  links: FooterLink[];
}

interface Props {
  brand?: string;
  /** One-line description of the site. */
  summary?: string;
  groups?: FooterGroup[];
  /** Fine print. Passed in; never invented here. */
  legal?: string;
  class?: string;
}

const { brand = 'Brand', summary, groups = [], legal, class: className } = Astro.props;
---

<footer class:list={['footer', 'on-deep', className]}>
  <Container>
    <div class="footer__top">
      <div class="footer__brand">
        <span class="footer__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round">
            <path d="M4 19V9M10 19V5M16 19v-7M22 19H2" />
          </svg>
        </span>
        <p class="footer__name">{brand}</p>
        {summary && <p class="footer__summary">{summary}</p>}
        <div class="footer__badge"><slot name="status" /></div>
      </div>

      {
        groups.map((group) => (
          <div class="footer__group">
            <h2 class="footer__heading">{group.heading}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a class="footer__link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer__bottom">
      {legal && <p class="footer__legal">{legal}</p>}
      <slot name="legal" />
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-deep);
    color: var(--color-on-deep-muted);
    padding-block: var(--space-7) var(--space-5);
    margin-top: auto;
  }

  .footer__top {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1.6fr) repeat(auto-fit, minmax(9rem, 1fr));
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-deep-border);
  }

  .footer__mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    margin-bottom: var(--space-3);
  }

  .footer__mark svg {
    width: 0.9375rem;
    height: 0.9375rem;
  }

  .footer__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: #fff;
  }

  .footer__summary {
    margin-top: var(--space-2);
    max-width: 34ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .footer__badge:not(:empty) {
    margin-top: var(--space-4);
  }

  .footer__heading {
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #fff;
  }

  .footer__link {
    display: inline-block;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-on-deep-muted);
    text-decoration: none;
  }

  .footer__link:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
  }

  .footer__legal {
    max-width: 74ch;
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 48rem) {
    .footer__top {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }
</style>
