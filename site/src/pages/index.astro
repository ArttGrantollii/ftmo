---
import { getEntry } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Disclosure from '../components/Disclosure.astro';
import ResearchFields from '../components/ResearchFields.astro';
import type { ResearchField } from '../components/ResearchFields.astro';
import AccountExplorer from '../components/AccountExplorer.astro';
import RiskCalculator from '../components/RiskCalculator.astro';
import FitCheck from '../components/FitCheck.astro';
import type { ProductGroup } from '../components/AccountExplorer.astro';

import { auditFirm, type DisplayFact } from '../lib/content/facts';
import { resolvePolicy } from '../lib/content/policy';

/**
 * Homepage — Phase 2B.
 *
 * The V2 information architecture from Phase 2A, now carrying researched and
 * sourced information about FTMO instead of placeholders.
 *
 * The rule that shapes this file: **no figure is written here.** Every number,
 * percentage, limit, threshold and money amount on the rendered page comes from
 * `content/firms/ftmo.yaml`, is validated by the Fact schema, and arrives with
 * the FTMO page it was read on and the date it was read. The prose below is
 * explanation — how a mechanism works and what it costs a trader to ignore —
 * and states no figure of its own. Sections that need figures declare which
 * facts they want and let `ResearchFields` render them together with their
 * caveats and sources.
 *
 * That separation is not stylistic. FTMO's terms change, several objectives
 * differ between the 1-Step and 2-Step products, and two figures that look
 * identical (the Maximum Loss percentage) are governed by different mechanisms.
 * A number typed into this file would drift away from its source silently; a
 * Fact cannot.
 *
 * Still deliberately out of scope: the calculator, the fit check, account
 * selection, the affiliate destination and its disclosure wording, the
 * `?source=meta` variant, analytics and structured data. FTMO Futures is
 * excluded from this page as a scope decision — see docs/CONTENT.md.
 */

// ---------------------------------------------------------------------------
// Facts
//
// `auditFirm` reports what the active policy permits rather than throwing on
// what it does not, so an expired or unpublishable value degrades to the
// "not verified yet" marker instead of breaking the page.
// ---------------------------------------------------------------------------
const policy = resolvePolicy(import.meta.env);
const ftmo = await getEntry('firms', 'ftmo');

if (!ftmo) {
  throw new Error('Firm record "ftmo" is missing from src/content/firms/.');
}

const audit = auditFirm(ftmo.data, policy);
const publishedFacts: ReadonlyMap<string, DisplayFact> = new Map(
  audit.publishable.map((fact) => [fact.key, fact]),
);

/** Most recent verification date across everything actually on the page. */
const lastChecked = audit.publishable
  .map((fact) => fact.lastVerified)
  .filter((date): date is Date => date instanceof Date)
  .sort((a, b) => b.getTime() - a.getTime())[0];

const lastCheckedLabel = lastChecked
  ? new Intl.DateTimeFormat('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(lastChecked)
  : null;

// ---------------------------------------------------------------------------
// Field lists
//
// Which questions each block answers. The `key` of each names the Fact that
// fills it; a field with no matching published Fact renders the marker.
// ---------------------------------------------------------------------------
const glanceFields: ResearchField[] = [
  { key: 'evaluation-models', label: 'Evaluation models' },
  { key: 'account-size-range', label: 'Account sizes' },
  { key: 'trading-period', label: 'Trading period' },
  { key: 'account-types', label: 'Account types' },
];

const commonAccountFields: ResearchField[] = [
  { key: 'account-size-range', label: 'Account sizes' },
  { key: 'trading-period', label: 'Trading period' },
  { key: 'platforms', label: 'Platforms' },
  { key: 'instruments', label: 'Instruments' },
];

const productGroups: ProductGroup[] = [
  {
    title: 'FTMO Challenge: 1-Step',
    summary: 'One evaluation phase, then an FTMO Account.',
    fields: [
      { key: 'one-step-profit-target', label: 'Profit target' },
      { key: 'one-step-max-daily-loss', label: 'Maximum Daily Loss' },
      { key: 'one-step-max-loss', label: 'Maximum Loss' },
      { key: 'one-step-best-day-rule', label: 'Best Day Rule' },
      { key: 'one-step-min-trading-days', label: 'Minimum trading days' },
      { key: 'one-step-reward-split', label: 'Reward share' },
      { key: 'one-step-fee-refund', label: 'Fee refund' },
    ],
  },
  {
    title: 'FTMO Challenge: 2-Step',
    summary: 'A Challenge phase, then a Verification phase, then an FTMO Account.',
    fields: [
      { key: 'two-step-challenge-profit-target', label: 'Profit target — Challenge' },
      { key: 'two-step-verification-profit-target', label: 'Profit target — Verification' },
      { key: 'two-step-max-daily-loss', label: 'Maximum Daily Loss' },
      { key: 'two-step-max-loss', label: 'Maximum Loss' },
      { key: 'two-step-min-trading-days', label: 'Minimum trading days' },
      { key: 'two-step-reward-split', label: 'Reward share' },
      { key: 'two-step-fee-refund', label: 'Fee refund' },
    ],
  },
];

const navItems = [
  { label: 'How it works', href: '#how' },
  { label: 'Accounts', href: '#accounts' },
  { label: 'Rules', href: '#rules' },
  { label: 'Calculator', href: '#calculator' },
  { label: 'Fit check', href: '#fit' },
  { label: 'FAQ', href: '#faq' },
];

const footerGroups = [
  {
    heading: 'Guide',
    links: [
      { label: 'How it works', href: '#how' },
      { label: 'Accounts', href: '#accounts' },
      { label: 'Rules', href: '#rules' },
      { label: 'Calculator', href: '#calculator' },
      { label: 'FAQ', href: '#faq' },
    ],
  },
  {
    heading: 'Transparency',
    links: [
      { label: 'Methodology', href: '#methodology' },
      { label: 'Disclosures', href: '#disclosures' },
      { label: 'Guides', href: '#guides' },
    ],
  },
];

// ---------------------------------------------------------------------------
// Editorial copy
//
// Explanation only. Nothing below states a figure — see the file comment.
// ---------------------------------------------------------------------------
const stages = [
  {
    title: 'Choose a model and a size',
    summary: 'Decide between the 1-Step and 2-Step Challenge, then pick an account size.',
    body: [
      'The two models are not the same product at a different price. They differ in how many phases you complete, how much you may lose in a day, whether the overall loss limit moves as the account grows, what share of the reward you start on, and whether the fee can come back to you. Those differences are set out side by side in the next section.',
      'You are buying an assessment, not capital. FTMO describes what you trade as simulated capital throughout, and the objectives are defined as percentages of that starting figure — so a larger account scales every limit with it while the percentages stay where they are.',
    ],
  },
  {
    title: 'Meet the Trading Objectives',
    summary: 'Reach the profit target without breaching a loss limit.',
    body: [
      'Every objective applies at the same time: reaching the target while breaching a limit is a failed evaluation, not a pass. Both loss limits are measured on equity — balance plus open profit and loss, adjusted for swaps and commissions — so an open losing position counts against you before you close it.',
      'The daily limit is recalculated each day at midnight Central European time, which is unlikely to be your own midnight. The overall limit behaves differently between the two models, and that difference is the single most consequential thing on this page to get right.',
    ],
  },
  {
    title: 'Trade an FTMO Account',
    summary: 'The profit target falls away; the risk limits do not.',
    body: [
      'Once funded there is no further profit target, but the loss limits continue to apply, and two restrictions that were dormant during the evaluation switch on for Standard accounts — one around selected news releases, one around holding positions through the weekend or a long market break. Swing accounts are exempt from both.',
      'This is where the reward share applies, where the fee refund is decided on the 2-Step product, and where the Scaling Plan can raise both the account size and the share you keep. Each of those has conditions attached rather than being automatic.',
    ],
  },
];

/**
 * Rule panels. Prose explains the mechanism; `fields` name the Facts that carry
 * the figures, so a limit and its caveat are always rendered from the record.
 */
const rules = [
  {
    name: 'Maximum Loss',
    flag: 'Ends the account',
    body: [
      'A floor under the account. If equity reaches it the account is closed, regardless of how much profit was made earlier.',
      'The two products use the same percentage through different mechanisms, and the difference decides how much room a winning run actually buys you. On 1-Step the floor is an end-of-day trailing limit that follows the account upward and never moves back down. On 2-Step it is static: fixed against the initial capital, staying there whatever the account does.',
    ],
    fields: [
      { key: 'one-step-max-loss', label: '1-Step' },
      { key: 'two-step-max-loss', label: '2-Step' },
    ],
  },
  {
    name: 'Maximum Daily Loss',
    flag: 'Ends the account',
    body: [
      'A cap on how far equity may fall within one trading day, recalculated at midnight Central European time rather than at your own.',
      'It is the tighter of the two allowances on both products, and the one most often reached after an early loss turns into an attempt to win it back. Because it is measured on equity, an open position that is deep enough in loss can breach it without ever being closed.',
    ],
    fields: [
      { key: 'one-step-max-daily-loss', label: '1-Step' },
      { key: 'two-step-max-daily-loss', label: '2-Step' },
    ],
  },
  {
    name: 'Profit targets and trading days',
    flag: 'Phase requirement',
    body: [
      'What each phase asks for before it can be completed. The 2-Step model splits the requirement across a Challenge phase and a lower Verification phase, and additionally requires trading on a minimum number of separate days — FTMO counts a trading day as any day on which at least one position is opened.',
      'Read the target against the loss allowance rather than on its own. The ratio between what you must make and what you may lose is what the evaluation is actually asking of you, and a smaller target paired with a tighter limit is not automatically the easier proposition.',
    ],
    fields: [
      { key: 'one-step-profit-target', label: '1-Step' },
      { key: 'two-step-challenge-profit-target', label: '2-Step — Challenge' },
      { key: 'two-step-verification-profit-target', label: '2-Step — Verification' },
      { key: 'one-step-min-trading-days', label: 'Trading days — 1-Step' },
      { key: 'two-step-min-trading-days', label: 'Trading days — 2-Step' },
    ],
  },
  {
    name: 'Best Day Rule',
    flag: '1-Step only',
    body: [
      'A consistency requirement on the 1-Step product: no single day may account for more than half of the profit made on your profitable days.',
      'It behaves unlike the loss limits. FTMO states that exceeding it is not a breach and does not end the account — the requirement is simply unmet, and it is satisfied by continuing to trade until the distribution evens out. Its practical effect is that one outsized day cannot complete the phase on its own.',
    ],
    fields: [{ key: 'one-step-best-day-rule', label: 'Requirement' }],
  },
  {
    name: 'News, weekend and rollover restrictions',
    flag: 'Funded accounts only',
    body: [
      'Two restrictions that are easy to overstate, and widely overstated. Neither applies during the evaluation, and neither applies to the Swing account type at any stage. Both apply only once you are trading a funded FTMO Account on a Standard account type.',
      'The news restriction covers a short window around selected announcements, on the instruments those announcements target, and it counts the execution of a pending order — including a Stop Loss or Take Profit — as opening or closing a trade. The weekend restriction requires positions to be closed before the market closes for the weekend, or where a market break runs long.',
    ],
    fields: [
      { key: 'news-restriction-window', label: 'News window' },
      { key: 'rollover-holding-limit', label: 'Rollover limit' },
      { key: 'account-types', label: 'Account types' },
    ],
  },
  {
    name: 'Rewards, refunds and scaling',
    flag: 'Money',
    body: [
      'The share you keep is not the same on both products, and on the 2-Step model it is not the share in the headline — that figure is the rate reached through the Scaling Plan or the Premium Programme, not the one you start on.',
      'The fee is treated differently too: on the 2-Step product it may come back with your first reward withdrawal, which makes it conditional on reaching a payout rather than on passing. On the 1-Step product FTMO states plainly that it does not come back at all. Budget accordingly.',
    ],
    fields: [
      { key: 'one-step-reward-split', label: 'Reward share — 1-Step' },
      { key: 'two-step-reward-split', label: 'Reward share — 2-Step' },
      { key: 'one-step-fee-refund', label: 'Fee refund — 1-Step' },
      { key: 'two-step-fee-refund', label: 'Fee refund — 2-Step' },
      { key: 'reward-request-day', label: 'First reward request' },
      { key: 'reward-minimum', label: 'Minimum reward' },
      { key: 'scaling-increase', label: 'Scaling increase' },
      { key: 'scaling-maximum', label: 'Scaling maximum' },
    ],
  },
];

/**
 * Fit notes. Each is traceable to a verified fact or to FTMO's own published
 * wording; none of them ranks FTMO or compares it to anything else.
 */
const goodFit = [
  'You want objectives that are published and fixed in advance rather than assessed at someone’s discretion',
  'You can work inside a daily loss limit measured on equity, so open losses count before you close them',
  'You do not need a deadline — there is no calendar limit on completing the evaluation',
  'You are comfortable choosing between two products whose loss limits behave differently',
];

const thinkCarefully = [
  'You would need the fee back if it goes badly — on the 1-Step product it is not refunded, and on 2-Step it depends on reaching a first payout',
  'You hold positions over the weekend — once funded, that is restricted on Standard accounts and unrestricted on Swing',
  'You trade the moment major news is released — once funded, Standard accounts face a restricted window around selected announcements',
  'You are expecting the headline reward share from day one on the 2-Step product — that rate is reached through the Scaling Plan or Premium Programme',
  'You are expecting a reliable income rather than an opportunity, or your process is still forming',
];

const trustPoints = [
  {
    text: 'Independent guide, not affiliated with FTMO',
    path: 'M12 3l7 3v5.5c0 4-3 7.5-7 9.5-4-2-7-5.5-7-9.5V6z',
  },
  {
    text: 'Every figure carries the FTMO page it came from and the date it was read',
    path: 'M6 3h9l3 3v15H6zM9 9h6M9 13h6M9 17h4',
  },
  {
    text: 'No guaranteed results, no performance claims, no rankings',
    path: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 8v5M12 16.5v.5',
  },
  {
    text: 'Always confirm current terms with FTMO before spending anything',
    path: 'M14 5h5v5M19 5l-8 8M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4',
  },
];

/** FAQ answers explain; figures come from `fields`, never from the prose. */
const faqs = [
  {
    q: 'What is FTMO?',
    a: 'FTMO is a proprietary trading firm that offers assessment-based access to funded trading accounts. You pay a fee for an evaluation, trade to a published set of Trading Objectives, and — if you meet them — trade an FTMO Account and keep an agreed share of the simulated profits. FTMO describes the capital as simulated throughout. This site is an independent guide to that model and is not operated by FTMO.',
  },
  {
    q: 'What is the difference between the 1-Step and 2-Step Challenge?',
    a: 'The number of phases is the visible difference, but not the important one. The 1-Step product runs a single evaluation phase, allows a smaller daily loss, applies a Best Day Rule, trails its overall loss limit upward as the account grows, and starts you on the higher reward share — but its fee is not refunded. The 2-Step product adds a Verification phase and a minimum trading days requirement, keeps its overall loss limit static, starts you on a lower reward share, and can refund the fee at your first payout.',
    fields: [
      { key: 'one-step-max-daily-loss', label: 'Daily loss — 1-Step' },
      { key: 'two-step-max-daily-loss', label: 'Daily loss — 2-Step' },
    ],
  },
  {
    q: 'How much does it cost?',
    a: 'This page publishes no price. FTMO’s fee table is produced by a selector in the browser rather than being present in the page it serves, so it could not be read and recorded the way every other figure here was — and at the time of checking, a promotional discount was running on at least one account size, which would have been captured as though it were the standard rate. A price that might be a temporary offer, or might vary by size, currency or region, is not something this site will state as fact. Check FTMO’s own pricing directly, and confirm the refund conditions for the product you are buying.',
  },
  {
    q: 'Is there a time limit?',
    a: 'No calendar deadline applies to completing the evaluation. Two qualifications matter: the unlimited period applies to accounts purchased after 13 July 2023, with older accounts keeping their original time-limited terms, and FTMO contacts traders whose accounts sit inactive, offering a freeze for planned absences. A minimum number of trading days applies to the 2-Step product, which sets a floor on how quickly it can be completed rather than a ceiling.',
    fields: [
      { key: 'trading-period', label: 'Trading period' },
      { key: 'two-step-min-trading-days', label: 'Minimum trading days — 2-Step' },
    ],
  },
  {
    q: 'How is the loss limit actually measured?',
    a: 'On equity, not on closed balance — balance plus open profit and loss, adjusted for swaps and commissions. An open position that is far enough underwater can therefore breach a limit before you have closed anything. The daily limit is recalculated at midnight Central European time, so the reset does not follow your own trading day unless you happen to share that clock.',
    fields: [
      { key: 'one-step-max-daily-loss', label: 'Daily — 1-Step' },
      { key: 'two-step-max-daily-loss', label: 'Daily — 2-Step' },
      { key: 'one-step-max-loss', label: 'Overall — 1-Step' },
      { key: 'two-step-max-loss', label: 'Overall — 2-Step' },
    ],
  },
  {
    q: 'Can I trade during news releases?',
    a: 'During the evaluation, yes — the news restriction does not apply there. It applies once you are trading a funded FTMO Account on a Standard account type, and covers a short window around selected announcements on the instruments those announcements target. Within that window nothing may be opened or closed, and the execution of a pending order such as a Stop Loss or Take Profit counts as closing. A position opened before the window may be held through it. Swing accounts have no news restriction at any stage.',
    fields: [{ key: 'news-restriction-window', label: 'Restricted window' }],
  },
  {
    q: 'Can I hold positions overnight and over the weekend?',
    a: 'During the evaluation, yes, on either account type. Once you are trading a funded FTMO Account the answer depends on the account type you chose: Standard requires positions to be closed shortly before the weekend market close, or where a rollover runs long, while Swing carries no overnight or weekend restriction at any stage. This is the main practical reason to decide between the two account types up front.',
    fields: [
      { key: 'rollover-holding-limit', label: 'Rollover limit' },
      { key: 'account-types', label: 'Account types' },
    ],
  },
  {
    q: 'What share of the profit do I keep, and when can I withdraw it?',
    a: 'The share differs by product, and on the 2-Step product the advertised headline is the rate you can reach rather than the rate you begin on — it rises once Scaling Plan or Premium Programme conditions are met. A reward can be requested from a set number of days after your first trade, subject to a minimum that depends on the withdrawal method. FTMO states that it charges no additional commission on reward withdrawals.',
    fields: [
      { key: 'one-step-reward-split', label: 'Reward share — 1-Step' },
      { key: 'two-step-reward-split', label: 'Reward share — 2-Step' },
      { key: 'reward-request-day', label: 'First request' },
      { key: 'reward-minimum', label: 'Minimum' },
    ],
  },
  {
    q: 'What can I trade, and can I use an EA?',
    a: 'FTMO states that you can trade the instruments available on your chosen platform, and that discretionary trading, algorithmic trading and Expert Advisors are all permitted, provided the approach complies with its risk-management standards and conforms to real market conditions. It notes technical limits on order volume, and cautions that widely shared third-party EAs can run into capital allocation limits because many traders may be running the same system. Separate forbidden-practices rules apply; check those directly rather than assuming a strategy is acceptable.',
    fields: [
      { key: 'platforms', label: 'Platforms' },
      { key: 'instruments', label: 'Instruments' },
    ],
  },
  {
    q: 'Does this site belong to FTMO?',
    a: 'No. It is an independent guide, not affiliated with, endorsed by or operated by FTMO, and not a support channel — contact FTMO directly about an account. Its commercial arrangements, and the disclosure describing them, are covered under disclosures below.',
  },
];

const guides = [
  {
    title: 'Trailing versus static loss limits',
    summary:
      'Why the same percentage behaves differently on the two products, and what each does to a winning run.',
  },
  {
    title: 'Sizing a position against a daily limit',
    summary:
      'Turning an equity-measured allowance into a losing streak you can survive, and what that implies for risk per trade.',
  },
  {
    title: 'Standard or Swing, decided up front',
    summary:
      'How the news and weekend restrictions on funded accounts interact with holding period and strategy.',
  },
  {
    title: 'What the reward share is worth in practice',
    summary:
      'Starting rates, the Scaling Plan conditions, request timing and thresholds — and when money actually arrives.',
  },
];
---

<BaseLayout
  title="FTMO explained — an independent guide to the evaluation model"
  description="An independent, educational guide to how FTMO's assessment model works: the stages, the rules that end accounts, and what to consider before buying. Figures are published only once verified against the firm's own material."
  noindex
>
  {/*
    `current` is deliberately unset. Every nav item is an in-page anchor, and
    `aria-current="page"` would tell a screen-reader user that one of them is
    the page they are already on — which is true of all six, so marking one is
    misleading. It becomes meaningful once these are separate pages.
  */}
  <SiteHeader slot="header" brand="FTMO Guide" brandNote="Independent" items={navItems}>
    {/*
      Persistent call to action. It points at the final section rather than
      outward: no affiliate destination exists, and one is not invented here.
      The affiliate phase replaces this href and the one in that section.
    */}
    <Button slot="actions" size="sm" href="#explore">Explore FTMO</Button>
  </SiteHeader>

  <!-- ===================================================================
       HERO
       =================================================================== -->
  <Section tone="deep" id="top" labelledby="hero-title">
    <SectionHeading
      id="hero-title"
      as="h1"
      eyebrow="Independent guide — not affiliated with FTMO"
      title="Understand FTMO before you buy."
      lede="A clear, independent guide to how the assessment model works, the rules that decide most outcomes, and what to weigh up before spending anything."
    />
    <div class="cluster hero__actions">
      <Button href="#how" size="lg">See how it works</Button>
      <Button href="#rules" size="lg" variant="secondary">Read the rules first</Button>
    </div>
    <ul class="hero__notes">
      <li>Independent guide</li>
      <li>Affiliate arrangements disclosed</li>
      <li>Every figure sourced to FTMO</li>
    </ul>
  </Section>

  <!-- ===================================================================
       AT A GLANCE — the research fields, filled from verified facts only
       =================================================================== -->
  <Section id="glance" labelledby="glance-title" class="glance">
    <Card variant="highlight" class="glance__card">
      <div class="glance__head">
        <div>
          <h2 id="glance-title" class="glance__title">FTMO at a glance</h2>
          <p class="glance__note">Structured research fields, not marketing claims.</p>
        </div>
        {
          lastCheckedLabel ? (
            <Badge variant="success">Checked {lastCheckedLabel}</Badge>
          ) : (
            <Badge variant="neutral">No verified values yet</Badge>
          )
        }
      </div>

      <ResearchFields fields={glanceFields} facts={publishedFacts} />

      <div class="glance__foot">
        <p>
          These four hold for both evaluation models. The figures that differ between them — the
          targets, the loss limits, the reward share and whether the fee comes back — are set out
          product by product under <a href="#accounts">account options</a>. Every value carries the
          FTMO page it was read on and the date it was read; nothing appears here before that.
        </p>
      </div>
    </Card>
  </Section>

  <!-- ===================================================================
       HOW IT WORKS
       =================================================================== -->
  <Section id="how" labelledby="how-title">
    <SectionHeading
      id="how-title"
      eyebrow="How it works"
      title="The model in three stages"
      lede="You buy an evaluation, trade to a published set of Trading Objectives, and — if you meet them — trade an FTMO Account. FTMO runs this as two products whose rules differ in ways worth knowing before you choose."
    />

    <ol class="stages">
      {
        stages.map((stage, index) => (
          <Card as="li" class="stage">
            <p class="stage__index" aria-hidden="true">
              {index + 1}
            </p>
            <div class="stage__text">
              <h3 class="stage__title">
                <span class="visually-hidden">Stage {index + 1}: </span>
                {stage.title}
              </h3>
              <p class="stage__summary">{stage.summary}</p>
              {stage.body.map((paragraph) => (
                <p class="stage__body">{paragraph}</p>
              ))}
            </div>
          </Card>
        ))
      }
    </ol>
  </Section>

  <!-- ===================================================================
       ACCOUNT EXPLORER — presentation structure only
       =================================================================== -->
  <Section id="accounts" tone="alt" labelledby="accounts-title">
    <SectionHeading
      id="accounts-title"
      eyebrow="Accounts"
      title="Account options explained"
      lede="FTMO runs the CFD evaluation as two products. Several objectives differ between them, and two figures that look identical are governed by different mechanisms — so they are set out separately rather than merged. Filter to one product, or read them side by side. FTMO’s own options only; this site ranks nothing."
    />
    <AccountExplorer
      commonFields={commonAccountFields}
      groups={productGroups}
      facts={publishedFacts}
    />
  </Section>

  <!-- ===================================================================
       RULES
       =================================================================== -->
  <Section id="rules" labelledby="rules-title">
    <SectionHeading
      id="rules-title"
      eyebrow="Rules"
      title="The rules to understand before buying"
      lede="Most accounts do not end because of a bad market view — they end on a risk rule. Each panel explains the mechanism, then shows the figures that govern it with the FTMO page each came from."
    />

    <div class="panels">
      {
        rules.map((rule) => (
          <Disclosure title={rule.name} meta={rule.flag}>
            {rule.body.map((paragraph) => (
              <p class="panel__body">{paragraph}</p>
            ))}
            <div class="panel__fields">
              <ResearchFields fields={rule.fields} facts={publishedFacts} minColumn="13rem" />
            </div>
          </Disclosure>
        ))
      }
    </div>

    <p class="panels__note">
      This is a summary of FTMO’s published objectives, not a substitute for them. FTMO also
      operates separate forbidden-practices rules that are not reproduced here. Confirm the current
      terms for the product you are buying before you buy it.
    </p>
  </Section>

  <!-- ===================================================================
       CALCULATOR — position held, behaviour not built
       =================================================================== -->
  <Section id="calculator" tone="alt" labelledby="calculator-title">
    <SectionHeading
      id="calculator-title"
      eyebrow="Calculator"
      title="Turning percentages into money"
      lede="A percentage is abstract until it is money. Enter an account size and each verified rule is shown beside the amount it comes to — the rule and the arithmetic kept visibly apart."
    />

    <RiskCalculator facts={publishedFacts} />

    <p class="tool__footnote">
      Everything here runs in your browser. Nothing is sent anywhere, nothing is stored, and
      refreshing the page clears it. The amounts are arithmetic on FTMO's published percentages,
      not figures FTMO publishes in dollars, and they are educational examples rather than trading
      or financial advice.
    </p>
  </Section>

  <!-- ===================================================================
       FIT CHECK — advantages and considerations
       =================================================================== -->
  <Section id="fit" labelledby="fit-title">
    <SectionHeading
      id="fit-title"
      eyebrow="Fit check"
      title="Is this model right for you?"
      lede="The two products differ in ways that suit different preferences. Answer the questions to see which set of published rules lines up with yours, then read the wider considerations beneath. This is an educational observation, not a recommendation."
    />

    <FitCheck facts={publishedFacts} class="fit__tool" />

    <div class="decide">
      <Card variant="info">
        <h3 class="decide__title">
          <svg
            class="decide__glyph"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="var(--color-positive)"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m5 12 5 5L20 7"></path>
          </svg>
          A good fit if
        </h3>
        <ul class="decide__list">
          {goodFit.map((item) => <li>{item}</li>)}
        </ul>
      </Card>

      <Card variant="info">
        <h3 class="decide__title">
          <svg
            class="decide__glyph"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            fill="none"
            stroke="var(--color-warning)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v5M12 16.5v.5"></path>
          </svg>
          Think carefully if
        </h3>
        <ul class="decide__list">
          {thinkCarefully.map((item) => <li>{item}</li>)}
        </ul>
      </Card>
    </div>
  </Section>

  <!-- ===================================================================
       METHODOLOGY / TRUST
       =================================================================== -->
  <Section id="methodology" tone="alt" labelledby="methodology-title">
    <SectionHeading
      id="methodology-title"
      eyebrow="Methodology"
      title="How this site handles information"
      lede="What separates something published here as fact from something the author remembers being true."
    />

    <div class="methodology">
      <Card>
        <h3>Where the figures come from</h3>
        <p>
          Every figure on this page was read on one of FTMO’s own pages — its Trading Objectives,
          How it works, Reward and Scaling Plan, and the relevant FAQ entries — and recorded with
          that page’s address, its publisher and the date it was read. Affiliate sites, forums,
          videos and comparison tables were not used. A value without a source is not a fact and
          does not appear.
        </p>
      </Card>
      <Card>
        <h3>What is deliberately missing</h3>
        <p>
          Prices are not published here. FTMO’s fee table is assembled in the browser rather than
          served in the page, and a promotion was running when these figures were checked — so any
          number captured would have risked presenting an offer as the standard rate. Where two
          FTMO pages appeared to disagree, the conflict was chased down rather than resolved by
          picking one.
        </p>
      </Card>
      <Card>
        <h3>What this site is not</h3>
        <p>
          It is not affiliated with FTMO, not a support channel, and not a source of financial
          advice. It ranks nothing, compares nothing and guarantees nothing. Terms change: a
          recorded value is flagged for re-checking once it passes a set age and stops being
          publishable past a further one. Confirm the current terms with FTMO before spending
          anything.
        </p>
      </Card>
    </div>

    <ul class="trust">
      {
        trustPoints.map((point) => (
          <li class="trust__item">
            <svg
              class="trust__glyph"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={point.path} />
            </svg>
            {point.text}
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ===================================================================
       FAQ
       =================================================================== -->
  <Section id="faq" labelledby="faq-title">
    <SectionHeading
      id="faq-title"
      eyebrow="FAQ"
      title="Common questions"
      lede="Answers explain the mechanism; the figures beneath them are rendered from the same sourced record as the rest of the page."
    />
    <div class="panels">
      {
        faqs.map((faq) => (
          <Disclosure title={faq.q}>
            <p class="panel__body">{faq.a}</p>
            {faq.fields && (
              <div class="panel__fields">
                <ResearchFields fields={faq.fields} facts={publishedFacts} minColumn="13rem" />
              </div>
            )}
          </Disclosure>
        ))
      }
    </div>
  </Section>

  <!-- ===================================================================
       GUIDES
       =================================================================== -->
  <Section id="guides" tone="alt" labelledby="guides-title">
    <SectionHeading
      id="guides-title"
      eyebrow="Guides"
      title="Going deeper"
      lede="Longer pieces on the parts of the model that decide outcomes — chosen from the differences this research actually turned up. These are written and published in a later phase; the titles below are planned, not live."
    />

    <ul class="guides">
      {
        guides.map((guide) => (
          <Card as="li" variant="info" class="guide">
            <p class="guide__flag">Planned</p>
            <h3 class="guide__title">{guide.title}</h3>
            <p class="guide__summary">{guide.summary}</p>
          </Card>
        ))
      }
    </ul>
  </Section>

  <!-- ===================================================================
       FINAL CALL TO ACTION

       The outbound destination is the affiliate phase's decision, not this
       one's. No URL is invented here, and no click is tracked. The same phase
       owns the `?source=meta` landing variant: it changes what this section
       says, so it attaches here rather than anywhere earlier in the page.
       =================================================================== -->
  <Section tone="deep" id="explore" labelledby="explore-title">
    <div class="explore">
      <h2 id="explore-title">Ready to look at FTMO itself?</h2>
      <p class="explore__body">
        You have seen how each model works, which rules decide most outcomes, and where the two
        products differ. The next step is FTMO’s own material: prices are not published here, and
        terms change, so read the current ones there before spending anything.
      </p>
      <p class="explore__pending">
        The outbound link is added once an approved destination and its disclosure wording exist.
        Nothing on this page links out, and nothing here is tracked.
      </p>
    </div>
  </Section>

  <!-- ===================================================================
       DISCLOSURES — structure only; wording belongs to the compliance phase
       =================================================================== -->
  <Section id="disclosures" labelledby="disclosures-title" class="disclosures">
    <h2 id="disclosures-title" class="visually-hidden">Disclosures</h2>
    <div class="disclosures__grid">
      <div>
        <h3 class="disclosures__title">Affiliate disclosure</h3>
        <p class="disclosures__body">
          Placeholder. This page contains no affiliate links and no tracking. The disclosure that
          will sit here — what the arrangement is, where it applies and how it is marked — is
          written and reviewed in the compliance phase.
        </p>
      </div>
      <div>
        <h3 class="disclosures__title">Risk disclaimer</h3>
        <p class="disclosures__body">
          Placeholder. This site publishes educational and informational content, not financial,
          investment, legal or tax advice. The reviewed wording, including its statements about
          risk and past performance, is added in the compliance phase.
        </p>
      </div>
    </div>
  </Section>

  <SiteFooter
    slot="footer"
    brand="FTMO Guide"
    summary="Independent FTMO information and education. Not affiliated with FTMO."
    groups={footerGroups}
    legal="Placeholder footer text. Company details, legal wording and disclosures are written in the compliance phase and are deliberately absent here. FTMO is a trademark of its owner and is referred to on this site for identification only."
  >
    <Badge slot="status" variant="neutral">Pre-release — no verified figures</Badge>
  </SiteFooter>
</BaseLayout>

